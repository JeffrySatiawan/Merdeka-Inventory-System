{
  "name": "Merdeka Share",
  "short_name": "Merdeka Share",
  "description": "Share PDF resi ke Merdeka Inventory System dari HP",
  "id": "/share",
  "start_url": "/share",
  "scope": "/share",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "categories": ["business", "productivity", "utilities"],
  "lang": "id-ID",
  "icons": [
    {
      "src": "/icons/merdeka-share-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/merdeka-share-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/merdeka-share-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared_files",
          "accept": ["application/pdf", ".pdf"]
        }
      ]
    }
  }
}
